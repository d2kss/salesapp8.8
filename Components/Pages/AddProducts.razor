@* @page "/order/products"

@using Securitas8.Shared.Models
@using SecuritasApp8.Shared.Models
@using SecuritasApp8.Shared.Services
@inject OrderService OrderService
@inject NavigationManager Nav
@inject OrderWorkflowStateService State
<Stepper />


<h5 class="mb-3">Add Products</h5>

<div class="row g-3">
    @foreach (var p in products)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm border-0">

                <!-- Product Image -->
                <div class="bg-light text-center p-2">
                    <img src="@p.ImageUrl"
                         class="img-fluid"
                         style="max-height:140px; object-fit:contain;" />
                </div>

                <div class="card-body d-flex flex-column">

                    <!-- Product Info -->
                    <h6 class="fw-semibold mb-1">@p.Name</h6>
                    <p class="text-muted small mb-2">
                        @p.Description
                    </p>

                    <!-- Price -->
                    <div class="mb-2">
                        <span class="fw-bold text-success fs-6">
                            ₹@p.Price
                        </span>
                        <span class="text-muted small">
                            / unit
                        </span>
                    </div>

                    <!-- Quantity + Discount -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <!-- Quantity -->
                        <div>
                            <label class="small fw-semibold d-block">
                                Quantity
                            </label>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary"
                                        @onclick="() => State.SetQuantity(p.Id, State.GetQuantity(p.Id) - 1)"
                                        disabled="@(quantities[p.Id] == 1)">
                                    −
                                </button>
                                <button class="btn btn-light" disabled>
                                    @quantities[p.Id]
                                </button>
                                <button class="btn btn-outline-secondary"
                                        @onclick="() => State.SetQuantity(p.Id, State.GetQuantity(p.Id) + 1)">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Discount -->
                        <div class="text-end">
                            <label class="small fw-semibold d-block">
                                Discount (%)
                            </label>
                            <input type="number"
                                   class="form-control form-control-sm text-end"
                                   style="width:90px"
                                   min="0"
                                   max="100"
                                   @bind="discounts[p.Id]" />
                        </div>

                    </div>

                    <!-- Add-ons -->
                    @if (p.AddOns.Any())
                    {
                        <div class="border rounded p-2 mb-3 bg-light">
                            <label class="small fw-semibold mb-1">
                                Add-on Services
                            </label>

                            @foreach (var a in p.AddOns)
                            {
                                <div class="form-check small">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @onchange="(e) => ToggleAddon(p.Id, a, (bool)e.Value!)" />
                                    <label class="form-check-label">
                                        @a.Name
                                        <span class="text-muted">
                                            (+₹@a.Price)
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <!-- CTA -->
                    <button class="btn btn-primary btn-sm w-100 mt-auto"
                            @onclick="() => AddItem(p)">
                        ➕ Add to Order
                    </button>
                </div>
            </div>
        </div>
    }
</div>


<div class="d-flex justify-content-between mt-4">
    <button class="btn btn-outline-secondary" @onclick="GoBack">
        ← Back
    </button>

    <button class="btn btn-primary" @onclick="GoNext">
        Next ➜
    </button>
</div> *@

