@page "/create-order"
@using Securitas8._8.Models
@using Securitas8._8.Services
@inject OrderService OrderService
@inject ProductService productService
@inject NavigationManager Nav

<h3>Create New Order</h3>

@* <h5>Customer Information</h5>
