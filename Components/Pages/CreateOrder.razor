<h5 class="mt-4 mb-3">Order Summary</h5>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Discount %</th>
            <th>Add-ons</th>
            <th>Final Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in order.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.DiscountPercent</td>
                <td>@string.Join(", ", item.SelectedAddOns.Select(a => a.Name))</td>
                <td>₹@item.FinalPrice</td>
            </tr>
        }
    </tbody>
</table>

<h5>Total Amount: ₹@order.TotalAmount</h5>

<button class="btn btn-success" @onclick="SubmitOrder">
    Submit Order
</button>
<button class="btn btn-outline-secondary"
        @onclick="GoBack">
    ← Back
</button>

@code {
    Order order = new()
    {
        SalesPerson = "Sales User",
        Status = "New"
    };

    List<Product> products;

    Dictionary<int, int> quantities = new();
    Dictionary<int, decimal> discounts = new();
    Dictionary<int, HashSet<int>> selectedAddOns = new();
    protected override void OnInitialized()
    {
        products = productService.GetProducts();

        foreach (var p in products)
        {
            quantities[p.Id] = 1;
            discounts[p.Id] = 0;
            selectedAddOns[p.Id] = new();
        }
    }
    void ToggleAddon(int pid, AddOnService a, bool val)
    {
        if (val) selectedAddOns[pid].Add(a.Id);
        else selectedAddOns[pid].Remove(a.Id);
    }
    int GetQuantity(int productId) => quantities[productId];

    void IncreaseQty(int productId)
    {
        quantities[productId]++;
    }

    void DecreaseQty(int productId)
    {
        if (quantities[productId] > 1)
            quantities[productId]--;
    }

    void AddItem(Product product)
    {
        order.Items.Add(new OrderItem
        {
            Product = product,
            Quantity = quantities[product.Id],
            DiscountPercent = discounts[product.Id],
            SelectedAddOns = product.AddOns.Where(a => selectedAddOns[product.Id].Contains(a.Id)).ToList()
        });

        quantities[product.Id] = 1;
        discounts[product.Id] = 0;
        selectedAddOns[product.Id].Clear();
    }

    void SubmitOrder()
    {
        OrderService.PlaceOrder(order);
        Nav.NavigateTo("/");
    }
    void GoBack()
    {
        Nav.NavigateTo("/");
    }
}
