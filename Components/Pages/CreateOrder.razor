<div class="card shadow-sm mb-4">
    <div class="card-header bg-light fw-semibold">
        👤 Customer Information
    </div>

    <div class="card-body">
        <!-- Customer Basic Info -->
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Customer Name</label>
                <input class="form-control"
                       placeholder="Full name"
                       @bind="order.Customer.Name" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email"
                       class="form-control"
                       placeholder="email@example.com"
                       @bind="order.Customer.Email" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input class="form-control"
                       placeholder="+91 98765 43210"
                       @bind="order.Customer.Phone" />
            </div>
        </div>

        <hr class="my-4" />

        <!-- Address Section -->
        <h6 class="fw-semibold mb-3">🏠 Address Information</h6>

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Street Address</label>
                <input class="form-control"
                       placeholder="House no, street, area"
                       @bind="order.Customer.Address.Street" />
            </div>

            <div class="col-md-4">
                <label class="form-label">City</label>
                <input class="form-control"
                       placeholder="City"
                       @bind="order.Customer.Address.City" />
            </div>

            <div class="col-md-4">
                <label class="form-label">State</label>
                <input class="form-control"
                       placeholder="State"
                       @bind="order.Customer.Address.State" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Postal Code</label>
                <input class="form-control"
                       placeholder="PIN / ZIP"
                       @bind="order.Customer.Address.PostalCode" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Country</label>
                <input class="form-control"
                       placeholder="Country"
                       @bind="order.Customer.Address.Country" />
            </div>
        </div>
    </div>
</div>
<h5 class="mb-3">Add Products</h5>

<div class="row g-3">
    @foreach (var p in products)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm border-0">

                <!-- Product Image -->
                <div class="bg-light text-center p-2">
                    <img src="@p.ImageUrl"
                         class="img-fluid"
                         style="max-height:140px; object-fit:contain;" />
                </div>

                <div class="card-body d-flex flex-column">

                    <!-- Product Info -->
                    <h6 class="fw-semibold mb-1">@p.Name</h6>
                    <p class="text-muted small mb-2">
                        @p.Description
                    </p>

                    <!-- Price -->
                    <div class="mb-2">
                        <span class="fw-bold text-success fs-6">
                            ₹@p.Price
                        </span>
                        <span class="text-muted small">
                            / unit
                        </span>
                    </div>

                    <!-- Quantity + Discount -->
                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <!-- Quantity -->
                        <div>
                            <label class="small fw-semibold d-block">
                                Quantity
                            </label>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary"
                                        @onclick="() => quantities[p.Id]--"
                                        disabled="@(quantities[p.Id] == 1)">
                                    −
                                </button>
                                <button class="btn btn-light" disabled>
                                    @quantities[p.Id]
                                </button>
                                <button class="btn btn-outline-secondary"
                                        @onclick="() => quantities[p.Id]++">
                                    +
                                </button>
                            </div>
                        </div>

                        <!-- Discount -->
                        <div class="text-end">
                            <label class="small fw-semibold d-block">
                                Discount (%)
                            </label>
                            <input type="number"
                                   class="form-control form-control-sm text-end"
                                   style="width:90px"
                                   min="0"
                                   max="100"
                                   @bind="discounts[p.Id]" />
                        </div>

                    </div>

                    <!-- Add-ons -->
                    @if (p.AddOns.Any())
                    {
                        <div class="border rounded p-2 mb-3 bg-light">
                            <label class="small fw-semibold mb-1">
                                Add-on Services
                            </label>

                            @foreach (var a in p.AddOns)
                            {
                                <div class="form-check small">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           @onchange="(e) => ToggleAddon(p.Id, a, (bool)e.Value!)" />
                                    <label class="form-check-label">
                                        @a.Name
                                        <span class="text-muted">
                                            (+₹@a.Price)
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                    }

                    <!-- CTA -->
                    <button class="btn btn-primary btn-sm w-100 mt-auto"
                            @onclick="() => AddItem(p)">
                        ➕ Add to Order
                    </button>
                </div>
            </div>
        </div>
    }
</div>

