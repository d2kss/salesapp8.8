@using Securitas8._8.Services
@inject OrderWorkflowStateService Workflow

<div class="order-progress mb-4">
    <div class="progress">
        <div class="progress-bar"
             role="progressbar"
             style="width:@Workflow.ProgressPercent%">
        </div>
    </div>

    <div class="d-flex justify-content-between mt-2">
        <span class="@StepClass(OrderStep.CustomerInfo)">Customer Info</span>
        <span class="@StepClass(OrderStep.Products)">Add Products</span>
        <span class="@StepClass(OrderStep.Summary)">Summary</span>
    </div>
</div>

@code {
    string StepClass(OrderStep step)
    {
        if (step < Workflow.CurrentStep) return "text-success fw-bold";
        if (step == Workflow.CurrentStep) return "text-primary fw-bold";
        return "text-muted";
    }
}